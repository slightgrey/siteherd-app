# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet

# Public URL of this dashboard. Baked into each site's connection key, so the
# WordPress plugin must be able to reach it.
APP_URL=http://localhost:3000

# Auth.js session encryption key. Generate one with: npx auth secret
AUTH_SECRET=

# Behind a reverse proxy (Nginx, Cloudflare) in production, Auth.js needs this to trust the forwarded host.
# AUTH_TRUST_HOST=true

# Optional, development only: extra CA for calling sites with self-signed HTTPS (e.g. Laragon *.test).
# SITE_CA_FILE=C:/laragon/etc/ssl/laragon.crt

# Wordfence Intelligence vulnerability feed (free key: wordfence.com → Account → Integrations).
# Without it, vulnerability checks are off.
WORDFENCE_API_KEY=

# Optional: who may create an account. SIGNUP_EMAILS is a comma-separated list
# (unset: anyone); signup closes once MAX_ACCOUNTS accounts exist (unset: no limit).
# SIGNUP_EMAILS=you@example.com
# MAX_ACCOUNTS=1
